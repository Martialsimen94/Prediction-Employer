# Copy to .env and adjust values for local development.
# Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=retention_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/retention_platform

# --- Redis / Celery ---
REDIS_DSN=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
